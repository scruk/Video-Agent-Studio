# Sao chép thành .env rồi điền. KHÔNG commit file .env.
ANTHROPIC_API_KEY=
# Tạo tại https://console.higgsfield.ai (mỗi credential gồm key ID + secret)
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# Tùy chọn: đổi model / endpoint
# BRAIN_MODEL=claude-opus-5-5
# SONNET_MODEL=claude-sonnet-5-5
# HAIKU_MODEL=claude-haiku-5-5
# HF_VIDEO_MODEL=higgsfield/cinema-studio/4.0

# Bee Voice AI (Vbee AIVoice - https://vbee.vn)
VBEE_APP_ID=
VBEE_ACCESS_TOKEN=
# VBEE_DEFAULT_VOICE=hn_female_ngochuyen_full_48k-fhg

# Pixabay (video B-roll miễn phí) - lấy key tại https://pixabay.com/api/docs
PIXABAY_API_KEY=
